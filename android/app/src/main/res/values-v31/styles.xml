<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ masks windowSplashScreenAnimatedIcon to a circle,
         which crops the square branding icon. Hide the system icon
         (transparent) and show the full-size square icon in Flutter
         plus legacy launch_background on API < 31. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">?android:colorBackground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
